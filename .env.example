# Copy to .env. Every value here has a working default; set only what you need.

# --- LLM -------------------------------------------------------------------
# mock = no key, no model weights: a canned LLM, a hashing embedder and a
# lexical reranker. Enough to click through the whole app.
# openai = any OpenAI-compatible endpoint; pick one preset below.
LLM_PROVIDER=mock

# Groq (free tier, fast)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=qwen/qwen3-32b
# LLM_REASONING_EFFORT=none

# Gemini (free tier)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.1-flash-lite

# Ollama on this machine (no key, no quota; slow on CPU). From docker compose
# the host is http://host.docker.internal:11434/v1 instead of localhost.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Failover: more models, asked in order when the one before is unavailable
# (a spent quota, an overloaded server) - only before the first token. Each
# has its own reasoning_effort: gemini-3.5-flash-lite rejects "none".
# LLM_FALLBACKS=[{"base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "api_key": "AIza...", "model": "gemini-3.5-flash-lite", "reasoning_effort": "low"}]

# Cascade: a stronger model, asked once more when the first answer fails the
# citation check although retrieval found good sources. Unset = no second try.
# LLM_ESCALATION={"base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "api_key": "AIza...", "model": "gemini-3.5-flash", "reasoning_effort": "none"}

# --- Retrieval ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounded_rag
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_WORKERS=1

# --- App ---------------------------------------------------------------------
# docker compose sets its own Postgres URL; this one is for running natively
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
UPLOAD_DIR=data/uploads
# Index every file of this directory on startup if it is not indexed yet
AUTO_SEED_DIR=data/corpus
# Required to upload or delete documents; empty = those routes are off
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false
# true once the site is served over HTTPS: the history cookie is then Secure
COOKIE_SECURE=false
# docker compose, behind a TLS proxy on this host: publish nginx locally only,
# and believe X-Forwarded-For from that proxy's address alone (the Docker
# network gateway; see the README)
# WEB_BIND=127.0.0.1:8080
# REAL_IP_FROM=172.18.0.1
# Only for a UI served from another origin; a JSON list, e.g. ["https://app.example.vn"]
# CORS_ORIGINS=[]
# Rerank score under which a source is dropped; tuned for bge-reranker-v2-m3
RETRIEVAL_MIN_SCORE=0.30
# The day "today" is, when a question gives no date
LAW_TIMEZONE=Asia/Ho_Chi_Minh
# docker compose: the database password (also read by compose itself)
POSTGRES_PASSWORD=
