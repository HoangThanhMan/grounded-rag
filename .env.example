# Copy to .env. Every value here has a working default; set only what you need.

# --- LLM -------------------------------------------------------------------
# mock = no key, no model weights: a canned LLM, a hashing embedder and a
# lexical reranker. Enough to click through the whole app.
# openai = any OpenAI-compatible endpoint; pick one preset below.
LLM_PROVIDER=mock

# Groq (free tier, fast)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=qwen/qwen3-32b
# LLM_REASONING_EFFORT=none

# Gemini (free tier)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.1-flash-lite

# Ollama on this machine (no key, no quota; slow on CPU)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- Retrieval ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounded_rag
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_WORKERS=1

# --- App ---------------------------------------------------------------------
# docker compose sets its own Postgres URL; this one is for running natively
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
UPLOAD_DIR=data/uploads
# Index every file of this directory on startup if it is not indexed yet
AUTO_SEED_DIR=data/corpus
# Required to upload or delete documents; empty = those routes are off
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=false
