# ---- LLM provider -----------------------------------------------------------
# one of: mock | ollama | vllm | openai | gemini | anthropic
# (anything else is a startup error, never a silent fallback to mock)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
# examples: qwen2.5:7b (ollama) · Qwen/Qwen2.5-7B-Instruct-AWQ (vllm)
#           gemini-2.5-flash (gemini) · claude-haiku-4-5-20251001 (anthropic)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Thinking models (Gemini 2.5/3.x flash, o-series...) spend output tokens on
# reasoning before answering, so a 512-token answer gets cut mid-sentence.
# "none" turns thinking off where the provider allows it; empty = not sent.
LLM_REASONING_EFFORT=
# USD per million tokens - fills meta.cost_usd; leave 0 for local models
LLM_INPUT_USD_PER_MTOK=0
LLM_OUTPUT_USD_PER_MTOK=0

OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Vector store -----------------------------------------------------------
# ":memory:" = Qdrant embedded mode, no server (tests, quick experiments)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounded_rag

# ---- Models -----------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# model calls (embed, rerank, NLI) at once; each already uses every core
MODEL_WORKERS=1

# ---- Admin ------------------------------------------------------------------
# POST /ingest is off while this is empty. Reads only directories under DATA_ROOT.
ADMIN_API_KEY=
DATA_ROOT=data

# ---- Evaluation -------------------------------------------------------------
# threshold of the NLI measuring instrument in eval/run.py (the guard's own
# threshold lives in configs/*.yaml) - see docs/07-evaluation-plan.md
ENTAILMENT_THRESHOLD=0.50
# LLM judge for eval/ragas_eval.py, any OpenAI-compatible endpoint
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# ---- Observability ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
