__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
*.egg-info/
# data/corpus/ IS committed: 500 KB of Công báo text, so `git clone` gives a
# working corpus without depending on that site still being up, and CI can
# resolve every gold ref in the evaluation dataset.
# data/sample_corpus/ IS committed too: the fast path for tests and CI eval.
reports/*
!reports/.gitkeep
# the first real run, kept as evidence of where the numbers started
!reports/smoke-2026-09-11/
# ablations: retrieval without documents, and the retrieval floor sweep
!reports/closed-book.json
!reports/floor-sweep.json
# the README Results table is generated from these; 2026-09-15 is the earlier Ollama run
!reports/2026-10-12-gemini/
reports/2026-10-12-gemini/*.log
# hand-graded labels are the independent check on the NLI instrument
!reports/hand-graded*.json
!reports/2026-09-15/
qdrant_storage/
.cache/
# the optional langfuse service in docker-compose.yml keeps its database here
langfuse_pgdata/
